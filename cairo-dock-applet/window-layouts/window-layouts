class WindowLayoutsApplet(CDApplet):
    """Expose the existing KWin actions as a Cairo-Dock sub-dock."""

    def __init__(self):
        self.entry_actions = {}
        self.custom_layout_count = 0
        self.configurator = None
        self.monitor_count = None
        self.workspace_count = None
        self.group_order = list(DEFAULT_GROUP_ORDER)
        self.custom_layout_signature = None
        cache_root = os.environ.get(
            "XDG_CACHE_HOME",
            os.path.expanduser("~/.cache"),
        )
        self.preview_directory = os.path.join(
            cache_root,
            "window-layouts-cairo-dock",
        )
        self.session_bus = dbus.SessionBus()
        super().__init__()

    @staticmethod
    def _command_output(arguments, timeout=4):
        completed = subprocess.run(
            arguments,
            check=True,
            capture_output=True,
            text=True,
            timeout=timeout,
        )
        return completed.stdout.strip()

    def _load_custom_layouts(self):
        try:
            encoded_layouts = self._command_output([
                "kreadconfig6",
                "--file",
                "kwinrc",
                "--group",
                "Script-windowlayouts",
                "--key",
                "CustomLayouts",
                "--default",
                "[]",
            ])
            layouts = json.loads(encoded_layouts or "[]")
        except (OSError, subprocess.SubprocessError, json.JSONDecodeError):
            return []

        if not isinstance(layouts, list):
            return []

        custom_groups = self._load_custom_groups()
        group_names = {group["id"]: group["name"] for group in custom_groups}
        group_fill_actions = {
            group["id"]: f"WindowLayoutsFillCustomGroup{group['fillShortcutSlot']}"
            for group in custom_groups
        }
        valid_layouts = []
        used_slots = set()
        for index, layout in enumerate(layouts[:20]):
            if not isinstance(layout, dict):
                continue
            name = layout.get("name")
            if not isinstance(name, str):
                continue
            geometry = [
                layout.get("x"),
                layout.get("y"),
                layout.get("width"),
                layout.get("height"),
            ]
            if any(
                isinstance(value, bool)
                or not isinstance(value, (int, float))
                or not math.isfinite(value)
                for value in geometry
            ):
                continue
            x, y, width, height = geometry
            if (x < 0 or y < 0 or width <= 0 or height <= 0
                    or x + width > 1.000001 or y + height > 1.000001):
                continue
            slot = layout.get("shortcutSlot")
            if (isinstance(slot, bool) or not isinstance(slot, int)
                    or not 1 <= slot <= 20 or slot in used_slots):
                slot = next(
                    (candidate for candidate in range(1, 21)
                     if candidate not in used_slots),
                    index + 1,
                )
            used_slots.add(slot)
            group_id = layout.get("groupId", "")
            if not isinstance(group_id, str) or group_id not in group_names:
                group_id = ""
            valid_layouts.append({
                "name": name.strip() or f"Custom Layout {index + 1}",
                "action": f"WindowLayoutsCustom{slot}",
                "group_name": group_names.get(group_id, ""),
                "group_id": group_id,
                "group_fill_action": group_fill_actions.get(group_id, ""),
                "x": x,
                "y": y,
                "width": width,
                "height": height,
            })
        return valid_layouts

    def _load_custom_groups(self):
        try:
            encoded = self._command_output([
                "kreadconfig6", "--file", "kwinrc",
                "--group", "Script-windowlayouts",
                "--key", "CustomGroups", "--default", "[]",
            ])
            groups = json.loads(encoded or "[]")
        except (OSError, subprocess.SubprocessError, json.JSONDecodeError):
            return []
        validated = []
        used_ids = set()
        used_slots = set()
        if not isinstance(groups, list):
            return validated
        for group in groups:
            if not isinstance(group, dict):
                continue
            group_id = group.get("id")
            name = group.get("name")
            if (not isinstance(group_id, str) or not group_id
                    or group_id in used_ids or not isinstance(name, str)
                    or not name.strip()):
                continue
            slot = group.get("fillShortcutSlot")
            if (isinstance(slot, bool) or not isinstance(slot, int)
                    or not 1 <= slot <= 20 or slot in used_slots):
                slot = next(
                    (candidate for candidate in range(1, 21)
                     if candidate not in used_slots),
                    len(validated) + 1,
                )
            validated.append({
                "id": group_id,
                "name": name.strip(),
                "fillShortcutSlot": slot,
            })
            used_ids.add(group_id)
            used_slots.add(slot)
        return validated

    def _save_custom_layouts(self, layouts):
        layouts_json = json.dumps(layouts, separators=(",", ":"))
        self._command_output([
            "kwriteconfig6",
            "--file",
            "kwinrc",
            "--group",
            "Script-windowlayouts",
            "--key",
            "CustomLayouts",
            layouts_json,
        ])
        self._command_output([
            "kwriteconfig6",
            "--file",
            "kwinrc",
            "--group",
            "Script-windowlayoutsfloatingbutton",
            "--key",
            "CustomLayouts",
            layouts_json,
        ])
        self._command_output([
            "kwriteconfig6",
            "--file",
            "kwinrc",
            "--group",
            "Script-windowlayoutsdragtargets",
            "--key",
            "CustomLayouts",
            layouts_json,
        ])

        # Keep the panel Plasmoid's configuration in sync when it is present.
        plasma_value = json.dumps(layouts_json)
        script = f"""var updated = false;
for (var panelIndex = 0; panelIndex < panelIds.length && !updated; panelIndex++) {{
    var panel = panelById(panelIds[panelIndex]);
    for (var widgetIndex = 0; widgetIndex < panel.widgetIds.length; widgetIndex++) {{
        var widget = panel.widgetById(panel.widgetIds[widgetIndex]);
        if (widget && widget.type === "org.example.windowlayouts") {{
            widget.currentConfigGroup = ["General"];
            widget.writeConfig("customLayouts", {plasma_value});
            updated = true;
            break;
        }}
    }}
}}
print(updated ? "updated" : "missing");"""
        try:
            self._command_output([
                "qdbus-qt6",
                "org.kde.plasmashell",
                "/PlasmaShell",
                "org.kde.PlasmaShell.evaluateScript",
                script,
            ], timeout=10)
        except (OSError, subprocess.SubprocessError):
            pass

        try:
            self._command_output([
                "qdbus-qt6",
                "org.kde.KWin",
                "/KWin",
                "org.kde.KWin.reconfigure",
            ])
        except (OSError, subprocess.SubprocessError):
            pass
        self.refresh_subdock()

    def _load_feature_settings(self):
        settings = {}
        for name, key in (
            ("floating_button_enabled", FLOATING_BUTTON_KEY),
            ("drag_targets_enabled", DRAG_TARGETS_KEY),
        ):
            try:
                value = self._command_output([
                    "kreadconfig6",
                    "--file",
                    "kwinrc",
                    "--group",
                    "Plugins",
                    "--key",
                    key,
                    "--default",
                    "false",
                ])
            except (OSError, subprocess.SubprocessError):
                value = "false"
            settings[name] = value.strip().lower() in ("1", "true", "yes", "on")
        try:
            show_all_targets = self._command_output([
                "kreadconfig6",
                "--file",
                "kwinrc",
                "--group",
                "Script-windowlayoutsdragtargets",
                "--key",
                "ShowAllTargets",
                "--default",
                "false",
            ])
        except (OSError, subprocess.SubprocessError):
            show_all_targets = "false"
        settings["show_all_drag_targets"] = (
            show_all_targets.strip().lower() in ("1", "true", "yes", "on")
        )

        try:
            target_placement = self._command_output([
                "kreadconfig6",
                "--file",
                "kwinrc",
                "--group",
                "Script-windowlayoutsdragtargets",
                "--key",
                "TargetPlacement",
                "--default",
                "zones",
            ])
        except (OSError, subprocess.SubprocessError):
            target_placement = "zones"
        settings["drag_target_placement"] = (
            target_placement if target_placement in ("zones", "top") else "zones"
        )

        try:
            show_all_top_targets = self._command_output([
                "kreadconfig6",
                "--file",
                "kwinrc",
                "--group",
                "Script-windowlayoutsdragtargets",
                "--key",
                "ShowAllTopTargets",
                "--default",
                "false",
            ])
        except (OSError, subprocess.SubprocessError):
            show_all_top_targets = "false"
        settings["show_all_top_drag_targets"] = (
            show_all_top_targets.strip().lower() in ("1", "true", "yes", "on")
        )

        try:
            floating_button_size = self._command_output([
                "kreadconfig6",
                "--file",
                "kwinrc",
                "--group",
                "Script-windowlayoutsfloatingbutton",
                "--key",
                "ButtonSize",
                "--default",
                "default",
            ])
        except (OSError, subprocess.SubprocessError):
            floating_button_size = "default"
        settings["floating_button_size"] = (
            floating_button_size
            if floating_button_size in FLOATING_BUTTON_SIZES
            else "default"
        )
        try:
            layout_padding = int(self._command_output([
                "kreadconfig6",
                "--file",
                "kwinrc",
                "--group",
                "Script-windowlayouts",
                "--key",
                "LayoutPadding",
                "--default",
                "0",
            ]))
        except (OSError, ValueError, subprocess.SubprocessError):
            layout_padding = 0
        settings["layout_padding"] = max(
            0,
            min(layout_padding, MAX_LAYOUT_PADDING),
        )
        settings["group_order"] = self._load_group_order()
        return settings

    @staticmethod
    def _validated_group_order(candidate):
        if not isinstance(candidate, list):
            candidate = []
        order = []
        for group_id in candidate:
            if group_id in DEFAULT_GROUP_ORDER and group_id not in order:
                order.append(group_id)
        if "fillDisplay" not in order:
            insert_at = order.index("window") if "window" in order else len(order)
            order.insert(insert_at, "fillDisplay")
        order.extend(group_id for group_id in DEFAULT_GROUP_ORDER if group_id not in order)
        return order

    def _load_group_order(self):
        try:
            encoded = self._command_output([
                "kreadconfig6",
                "--file",
                "kwinrc",
                "--group",
                "Script-windowlayouts",
                "--key",
                "GroupOrder",
                "--default",
                json.dumps(DEFAULT_GROUP_ORDER, separators=(",", ":")),
            ])
            candidate = json.loads(encoded)
        except (OSError, subprocess.SubprocessError, json.JSONDecodeError):
            candidate = []
        return self._validated_group_order(candidate)

    def _save_feature_settings(self, settings):
        floating_enabled = bool(settings.get("floating_button_enabled", False))
        drag_targets_enabled = bool(settings.get("drag_targets_enabled", False))
        target_placement = str(settings.get("drag_target_placement", "zones"))
        if target_placement not in ("zones", "top"):
            target_placement = "zones"
        show_all_zone_targets = bool(settings.get("show_all_drag_targets", False))
        show_all_top_targets = bool(
            settings.get("show_all_top_drag_targets", False)
        )
        floating_button_size = str(settings.get("floating_button_size", "default"))
        if floating_button_size not in FLOATING_BUTTON_SIZES:
            floating_button_size = "default"
        try:
            layout_padding = int(settings.get("layout_padding", 0))
        except (TypeError, ValueError):
            layout_padding = 0
        layout_padding = max(0, min(layout_padding, MAX_LAYOUT_PADDING))
        group_order = self._validated_group_order(settings.get("group_order", []))
        self._command_output([
            "qdbus-qt6",
            "org.example.WindowLayouts.Configurator",
            "/org/example/WindowLayouts/Configurator",
            "org.example.WindowLayouts.Configurator.SetFeatureSettingsV3",
            "true" if floating_enabled else "false",
            "true" if drag_targets_enabled else "false",
            target_placement,
            "true" if show_all_zone_targets else "false",
            "true" if show_all_top_targets else "false",
            floating_button_size,
            json.dumps(group_order, separators=(",", ":")),
            str(layout_padding),
        ], timeout=10)
        GLib.timeout_add(300, self._refresh_subdock_after_save)

    def _refresh_subdock_after_save(self):
        self.refresh_subdock()
        return GLib.SOURCE_REMOVE

    def _workspace_count(self):
        try:
            manager = self.session_bus.get_object(
                "org.kde.KWin",
                "/VirtualDesktopManager",
            )
            properties = dbus.Interface(
                manager,
                "org.freedesktop.DBus.Properties",
            )
            return int(properties.Get(
                "org.kde.KWin.VirtualDesktopManager",
                "count",
            ))
        except dbus.DBusException:
            return self.workspace_count if self.workspace_count is not None else 1

    def _monitor_count(self):
        try:
            screen_data = json.loads(self._command_output(
                ["kscreen-doctor", "-j"],
                timeout=3,
            ))
        except (OSError, subprocess.SubprocessError, json.JSONDecodeError):
            return self.monitor_count if self.monitor_count is not None else 1

        outputs = screen_data.get("outputs", [])
        return sum(
            1
            for output in outputs
            if output.get("connected") and output.get("enabled")
        )

    def _append_entry(self, sub_icons, label, image, action):
        entry_id = f"entry-{len(self.entry_actions)}"
        self.entry_actions[entry_id] = action
        sub_icons.extend([label, image, entry_id])

    def _write_preview(self, filename, svg):
        os.makedirs(self.preview_directory, mode=0o755, exist_ok=True)
        path = os.path.join(self.preview_directory, filename)
        try:
            with open(path, "w", encoding="utf-8") as preview_file:
                preview_file.write(svg)
        except OSError:
            return "view-grid"
        return path

    def _layout_preview(self, x, y, width, height):
        coordinates = [
            round(value * 1_000_000)
            for value in (x, y, width, height)
        ]
        filename = "layout-{}-{}-{}-{}.svg".format(*coordinates)
        canvas_x = 8 + x * 80
        canvas_y = 8 + y * 48
        canvas_width = width * 80
        canvas_height = height * 48
        svg = f"""<svg xmlns="http://www.w3.org/2000/svg" width="96" height="64" viewBox="0 0 96 64">
  <rect x="2" y="2" width="92" height="60" rx="6" fill="#2f273b" stroke="#d8c8ee" stroke-width="3"/>
  <rect x="8" y="8" width="80" height="48" rx="2" fill="#4a4058"/>
  <rect x="{canvas_x:.3f}" y="{canvas_y:.3f}" width="{canvas_width:.3f}" height="{canvas_height:.3f}" rx="2" fill="#a855f7" stroke="#e9d5ff" stroke-width="1.5"/>
</svg>
"""
        return self._write_preview(filename, svg)

    def _fill_preview(self, geometries):
        coordinates = "-".join(
            str(round(value * 1_000_000))
            for geometry in geometries
            for value in geometry
        )
        rectangles = []
        for x, y, width, height in geometries:
            rectangles.append(
                '<rect x="{:.3f}" y="{:.3f}" width="{:.3f}" height="{:.3f}" '
                'rx="2" fill="#a855f7" stroke="#e9d5ff" stroke-width="1.5"/>'.format(
                    8 + x * 80,
                    8 + y * 48,
                    width * 80,
                    height * 48,
                )
            )
        svg = """<svg xmlns="http://www.w3.org/2000/svg" width="96" height="64" viewBox="0 0 96 64">
  <rect x="2" y="2" width="92" height="60" rx="6" fill="#2f273b" stroke="#d8c8ee" stroke-width="3"/>
  <rect x="8" y="8" width="80" height="48" rx="2" fill="#4a4058"/>
  {}
</svg>
""".format("\n  ".join(rectangles))
        digest = hashlib.sha256(coordinates.encode("ascii")).hexdigest()[:16]
        return self._write_preview(f"fill-{digest}.svg", svg)

    def _monitor_preview(self, direction, enabled):
        state = "active" if enabled else "disabled"
        color = "#a855f7" if enabled else "#77717f"
        outline = "#ead7ff" if enabled else "#aaa5af"
        if direction == "previous":
            arrow = "M43 22 L31 32 L43 42"
        else:
            arrow = "M53 22 L65 32 L53 42"
        svg = f"""<svg xmlns="http://www.w3.org/2000/svg" width="96" height="64" viewBox="0 0 96 64">
  <rect x="4" y="10" width="36" height="30" rx="3" fill="#36313d" stroke="{outline}" stroke-width="3"/>
  <rect x="56" y="24" width="36" height="30" rx="3" fill="#36313d" stroke="{outline}" stroke-width="3"/>
  <path d="{arrow}" fill="none" stroke="{color}" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"/>
  <path d="M14 48 H30 M66 58 H82" stroke="{outline}" stroke-width="3" stroke-linecap="round"/>
</svg>
"""
        return self._write_preview(f"monitor-{direction}-{state}.svg", svg)

    def _refresh_capabilities_if_changed(self):
        # Changes made by the panel or floating configurator arrive through
        # kwinrc, not a Cairo-Dock signal. Poll the small capability set so the
        # sub-dock eventually reflects those shared settings.
        monitor_count = self._monitor_count()
        workspace_count = self._workspace_count()
        group_order = self._load_group_order()
        custom_layouts = self._load_custom_layouts()
        layout_signature = self._custom_layout_signature(custom_layouts)
        if (monitor_count != self.monitor_count
                or workspace_count != self.workspace_count
                or group_order != self.group_order
                or layout_signature != self.custom_layout_signature):
            self.refresh_subdock(
                monitor_count=monitor_count,
                workspace_count=workspace_count,
                group_order=group_order,
                custom_layouts=custom_layouts,
            )
        return GLib.SOURCE_CONTINUE

    @staticmethod
    def _custom_layout_signature(custom_layouts):
        """Return the values that affect Cairo-Dock's custom-layout entries."""
        return tuple((
            layout["name"],
            layout["action"],
            layout["group_name"],
            layout["group_id"],
            layout["group_fill_action"],
            layout["x"],
            layout["y"],
            layout["width"],
            layout["height"],
        ) for layout in custom_layouts)

    def refresh_subdock(
        self,
        monitor_count=None,
        workspace_count=None,
        group_order=None,
        custom_layouts=None,
    ):
        """Rebuild entries from the latest KWin and display configuration."""
        sub_icons = []
        self.entry_actions = {}

        grouped_entries = {group_id: [] for group_id in DEFAULT_GROUP_ORDER}

        for group_id, label, action, x, y, width, height in FIXED_LAYOUTS:
            grouped_entries[group_id].append((
                label,
                self._layout_preview(x, y, width, height),
                action,
            ))

        if custom_layouts is None:
            custom_layouts = self._load_custom_layouts()
        self.custom_layout_signature = self._custom_layout_signature(
            custom_layouts
        )
        self.custom_layout_count = len(custom_layouts)
        for layout in custom_layouts:
            grouped_entries["custom"].append((
                layout["name"],
                self._layout_preview(
                    layout["x"],
                    layout["y"],
                    layout["width"],
                    layout["height"],
                ),
                layout["action"],
            ))

        for label, action, geometries in BUILTIN_FILL_GROUPS:
            grouped_entries["fillDisplay"].append((
                f"Fill: {label}",
                self._fill_preview(geometries),
                action,
            ))
        custom_groups = self._load_custom_groups()
        for group in custom_groups:
            geometries = [
                (layout["x"], layout["y"], layout["width"], layout["height"])
                for layout in custom_layouts
                if layout["group_id"] == group["id"]
            ]
            if not geometries:
                continue
            grouped_entries["fillDisplay"].append((
                f"Fill: {group['name']}",
                self._fill_preview(geometries),
                f"WindowLayoutsFillCustomGroup{group['fillShortcutSlot']}",
            ))

        for label, action, geometry, fallback_image in WINDOW_ACTIONS:
            image = (
                self._layout_preview(*geometry)
                if geometry is not None
                else fallback_image
            )
            grouped_entries["window"].append((label, image, action))

        self.workspace_count = (
            workspace_count
            if workspace_count is not None
            else self._workspace_count()
        )
        if self.workspace_count > 1:
            grouped_entries["window"].append((
                "Previous Workspace",
                "go-previous",
                "WindowLayoutsPreviousWorkspace",
            ))
            grouped_entries["window"].append((
                "Next Workspace",
                "go-next",
                "WindowLayoutsNextWorkspace",
            ))

        self.monitor_count = (
            monitor_count
            if monitor_count is not None
            else self._monitor_count()
        )
        monitor_actions_enabled = self.monitor_count > 1
        for label, direction, action in (
            ("Previous Monitor", "previous", "WindowLayoutsPreviousMonitor"),
            ("Next Monitor", "next", "WindowLayoutsNextMonitor"),
        ):
            grouped_entries["window"].append((
                label if monitor_actions_enabled else f"{label} (Unavailable)",
                self._monitor_preview(direction, monitor_actions_enabled),
                action if monitor_actions_enabled else None,
            ))

        grouped_entries["window"].append(("Configure…", "configure", "__configure__"))

        # Cairo-Dock has no section headers, so append each group's contiguous
        # block in the configured order to preserve the same menu structure.
        self.group_order = (
            group_order
            if group_order is not None
            else self._load_group_order()
        )
        for group_id in self.group_order:
            for label, image, action in grouped_entries[group_id]:
                self._append_entry(sub_icons, label, image, action)

        try:
            self.sub_icons.RemoveSubIcon("any")
        except dbus.DBusException:
            pass
        self.sub_icons.AddSubIcons(sub_icons)
        self.icon.SetQuickInfo(
            str(self.custom_layout_count) if self.custom_layout_count else ""
        )

    def _show_error(self, message):
        try:
            self.icon.ShowDialog(message, 5)
        except dbus.DBusException:
            pass

    def _invoke_kwin_action(self, action_id):
        try:
            component = self.session_bus.get_object(
                "org.kde.kglobalaccel",
                "/component/kwin",
            )
            shortcuts = dbus.Interface(
                component,
                "org.kde.kglobalaccel.Component",
            )
            shortcuts.invokeShortcut(action_id)
        except dbus.DBusException as error:
            self._show_error(f"Could not invoke the KWin action: {error}")

    def _open_plasma_configuration(self):
        try:
            service = self.session_bus.get_object(
                "org.example.WindowLayouts.Configurator",
                "/org/example/WindowLayouts/Configurator",
            )
            dbus.Interface(
                service, "org.example.WindowLayouts.Configurator"
            ).Show()
        except Exception as error:
            self._show_error(f"Could not open the layout configurator: {error}")

    def begin(self):
        self.icon.SetLabel("Window Layouts")
        icon_path = os.path.join(self.cShareDataDir, "icon")
        if os.path.exists(icon_path):
            self.icon.SetIcon(icon_path)
        self.refresh_subdock()
        GLib.timeout_add_seconds(
            CAPABILITY_REFRESH_SECONDS,
            self._refresh_capabilities_if_changed,
        )

    def reload(self):
        self.refresh_subdock()

    def on_click(self, _state):
        self.refresh_subdock()

    def on_middle_click(self):
        self._open_plasma_configuration()

    def on_click_sub_icon(self, _state, icon_id):
        action = self.entry_actions.get(str(icon_id))
        if action == "__configure__":
            self._open_plasma_configuration()
        elif action:
            self._invoke_kwin_action(action)

    def on_build_menu(self):
        self.icon.AddMenuItems([
            {
                "label": "Configure layouts…",
                "icon": "configure",
                "id": CONFIGURE_MENU_ID,
            },
            {
                "label": "Refresh layouts",
                "icon": "view-refresh",
                "id": REFRESH_MENU_ID,
            },
        ])

    def on_menu_select(self, entry_id):
        selected_id = int(entry_id)
        if selected_id == CONFIGURE_MENU_ID:
            self._open_plasma_configuration()
        elif selected_id == REFRESH_MENU_ID:
            self.refresh_subdock()


if __name__ == "__main__":
    WindowLayoutsApplet().run()
