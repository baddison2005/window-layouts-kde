class LayoutStorage:
    """Read, validate, and synchronize custom layouts across frontends."""

    @staticmethod
    def _command_output(arguments, timeout=10):
        completed = subprocess.run(
            arguments,
            check=True,
            capture_output=True,
            text=True,
            timeout=timeout,
        )
        return completed.stdout.strip()

    @staticmethod
    def _validated_layout(candidate, index, used_slots=None, group_ids=None):
        if not isinstance(candidate, dict):
            return None

        name = candidate.get("name")
        geometry = [
            candidate.get("x"),
            candidate.get("y"),
            candidate.get("width"),
            candidate.get("height"),
        ]
        if not isinstance(name, str) or any(
            isinstance(value, bool)
            or not isinstance(value, (int, float))
            or not math.isfinite(value)
            for value in geometry
        ):
            return None

        x, y, width, height = geometry
        if (x < 0 or y < 0 or width <= 0 or height <= 0
                or x + width > 1.000001 or y + height > 1.000001):
            return None

        used_slots = used_slots if used_slots is not None else []
        slot = candidate.get("shortcutSlot")
        if (isinstance(slot, bool) or not isinstance(slot, int)
                or not 1 <= slot <= MAX_LAYOUTS or slot in used_slots):
            slot = next(
                (candidate_slot for candidate_slot in range(1, MAX_LAYOUTS + 1)
                 if candidate_slot not in used_slots),
                index + 1,
            )
        used_slots.append(slot)
        group_id = candidate.get("groupId", "")
        if (not isinstance(group_id, str)
                or (group_ids is not None and group_id not in group_ids)):
            group_id = ""

        return {
            "name": name.strip() or f"Custom Layout {index + 1}",
            "x": x,
            "y": y,
            "width": width,
            "height": height,
            "shortcutSlot": slot,
            "groupId": group_id,
        }

    @staticmethod
    def _validated_custom_groups(candidate):
        if isinstance(candidate, str):
            try:
                candidate = json.loads(candidate)
            except json.JSONDecodeError:
                candidate = []
        if not isinstance(candidate, list):
            return []
        groups = []
        used_ids = set()
        for group in candidate:
            if not isinstance(group, dict):
                continue
            group_id = group.get("id")
            name = group.get("name")
            if (not isinstance(group_id, str) or not group_id
                    or group_id in used_ids or not isinstance(name, str)
                    or not name.strip()):
                continue
            groups.append({"id": group_id, "name": name.strip()})
            used_ids.add(group_id)
        return groups

    def load_custom_groups(self):
        encoded = self._read_script_setting(
            "Script-windowlayouts", CUSTOM_GROUPS_KEY, "[]"
        )
        return self._validated_custom_groups(encoded)

    def load(self):
        try:
            encoded = self._command_output([
                "kreadconfig6",
                "--file",
                "kwinrc",
                "--group",
                "Script-windowlayouts",
                "--key",
                "CustomLayouts",
                "--default",
                "[]",
            ])
            candidates = json.loads(encoded or "[]")
        except (OSError, subprocess.SubprocessError, json.JSONDecodeError):
            return []

        if not isinstance(candidates, list):
            return []

        groups = self.load_custom_groups()
        group_ids = {"", *(group["id"] for group in groups)}
        layouts = []
        used_slots = []
        for index, candidate in enumerate(candidates[:MAX_LAYOUTS]):
            layout = self._validated_layout(candidate, index, used_slots, group_ids)
            if layout is not None:
                layouts.append(layout)
        return layouts

    def save(self, layouts):
        encoded = json.dumps(layouts, separators=(",", ":"))
        for group in (
            "Script-windowlayouts",
            "Script-windowlayoutsfloatingbutton",
            "Script-windowlayoutsdragtargets",
        ):
            self._command_output([
                "kwriteconfig6",
                "--file",
                "kwinrc",
                "--group",
                group,
                "--key",
                "CustomLayouts",
                encoded,
            ])

        # Synchronize the panel widget when one is installed. Plasma's script
        # receives a JSON string literal, so names remain correctly escaped.
        plasma_value = json.dumps(encoded)
        script = f"""var updated = false;
for (var panelIndex = 0; panelIndex < panelIds.length && !updated; panelIndex++) {{
    var panel = panelById(panelIds[panelIndex]);
    for (var widgetIndex = 0; widgetIndex < panel.widgetIds.length; widgetIndex++) {{
        var widget = panel.widgetById(panel.widgetIds[widgetIndex]);
        if (widget && widget.type === "org.example.windowlayouts") {{
            widget.currentConfigGroup = ["General"];
            widget.writeConfig("customLayouts", {plasma_value});
            updated = true;
            break;
        }}
    }}
}}
print(updated ? "updated" : "missing");"""
        try:
            self._command_output([
                "qdbus-qt6",
                "org.kde.plasmashell",
                "/PlasmaShell",
                "org.kde.PlasmaShell.evaluateScript",
                script,
            ])
        except (OSError, subprocess.SubprocessError):
            pass

        self._reconfigure_kwin()
        self._reload_cairo_dock()

    def save_custom_groups(self, groups):
        groups = self._validated_custom_groups(groups)
        encoded = json.dumps(groups, separators=(",", ":"))
        for group in (
            "Script-windowlayouts",
            "Script-windowlayoutsfloatingbutton",
            "Script-windowlayoutsdragtargets",
        ):
            self._command_output([
                "kwriteconfig6", "--file", "kwinrc", "--group", group,
                "--key", CUSTOM_GROUPS_KEY, encoded,
            ])
        plasma_value = json.dumps(encoded)
        script = f"""var updated = false;
for (var panelIndex = 0; panelIndex < panelIds.length && !updated; panelIndex++) {{
    var panel = panelById(panelIds[panelIndex]);
    for (var widgetIndex = 0; widgetIndex < panel.widgetIds.length; widgetIndex++) {{
        var widget = panel.widgetById(panel.widgetIds[widgetIndex]);
        if (widget && widget.type === "org.example.windowlayouts") {{
            widget.currentConfigGroup = ["General"];
            widget.writeConfig("customGroups", {plasma_value});
            updated = true;
            break;
        }}
    }}
}}
print(updated ? "updated" : "missing");"""
        try:
            self._command_output([
                "qdbus-qt6", "org.kde.plasmashell", "/PlasmaShell",
                "org.kde.PlasmaShell.evaluateScript", script,
            ])
        except (OSError, subprocess.SubprocessError):
            pass
        self._reconfigure_kwin()
        self._reload_cairo_dock()

    @classmethod
    def _read_plugin_enabled(cls, key):
        try:
            value = cls._command_output([
                "kreadconfig6",
                "--file",
                "kwinrc",
                "--group",
                "Plugins",
                "--key",
                key,
                "--default",
                "false",
            ])
        except (OSError, subprocess.SubprocessError):
            return False
        return value.strip().lower() in ("1", "true", "yes", "on")

    def load_feature_settings(self):
        floating_button_size = self._read_script_setting(
            FLOATING_BUTTON_GROUP,
            FLOATING_BUTTON_SIZE_KEY,
            "default",
        )
        if floating_button_size not in FLOATING_BUTTON_SIZES:
            floating_button_size = "default"
        group_order = self._validated_group_order(self._read_script_setting(
            "Script-windowlayouts",
            GROUP_ORDER_KEY,
            json.dumps(DEFAULT_GROUP_ORDER, separators=(",", ":")),
        ))
        target_placement = self._read_script_setting(
            DRAG_TARGETS_GROUP,
            TARGET_PLACEMENT_KEY,
            "zones",
        )
        if target_placement not in ("zones", "top"):
            target_placement = "zones"
        layout_padding = self._validated_layout_padding(
            self._read_script_setting(
                "Script-windowlayouts",
                LAYOUT_PADDING_KEY,
                "0",
            )
        )
        return {
            "floating_button_enabled": self._read_plugin_enabled(FLOATING_BUTTON_KEY),
            "drag_targets_enabled": self._read_plugin_enabled(DRAG_TARGETS_KEY),
            "show_all_drag_targets": self._read_script_setting(
                DRAG_TARGETS_GROUP,
                SHOW_ALL_TARGETS_KEY,
                "false",
            ).strip().lower() in ("1", "true", "yes", "on"),
            "drag_target_placement": target_placement,
            "show_all_top_drag_targets": self._read_script_setting(
                DRAG_TARGETS_GROUP,
                SHOW_ALL_TOP_TARGETS_KEY,
                "false",
            ).strip().lower() in ("1", "true", "yes", "on"),
            "floating_button_size": floating_button_size,
            "layout_padding": layout_padding,
            "group_order": group_order,
        }

    @staticmethod
    def _validated_layout_padding(candidate):
        try:
            value = int(candidate)
        except (TypeError, ValueError):
            value = 0
        return max(0, min(value, MAX_LAYOUT_PADDING))

    @staticmethod
    def _validated_group_order(candidate):
        # Group IDs are stored instead of translated labels. Keep unknown,
        # duplicate, and missing IDs from making an old user configuration
        # unusable when a later release introduces another group.
        if isinstance(candidate, str):
            try:
                candidate = json.loads(candidate)
            except json.JSONDecodeError:
                candidate = []
        if not isinstance(candidate, (list, tuple)):
            candidate = []

        order = []
        for group_id in candidate:
            if group_id in DEFAULT_GROUP_ORDER and group_id not in order:
                order.append(group_id)
        order.extend(group_id for group_id in DEFAULT_GROUP_ORDER if group_id not in order)
        return order

    @classmethod
    def _read_script_setting(cls, group, key, default):
        try:
            return cls._command_output([
                "kreadconfig6",
                "--file",
                "kwinrc",
                "--group",
                group,
                "--key",
                key,
                "--default",
                default,
            ])
        except (OSError, subprocess.SubprocessError):
            return default

    def save_feature_settings(self, settings):
        floating_enabled = bool(settings.get("floating_button_enabled", False))
        drag_targets_enabled = bool(settings.get("drag_targets_enabled", False))
        show_all_drag_targets = bool(settings.get("show_all_drag_targets", False))
        target_placement = str(settings.get("drag_target_placement", "zones"))
        if target_placement not in ("zones", "top"):
            target_placement = "zones"
        show_all_top_drag_targets = bool(
            settings.get("show_all_top_drag_targets", False)
        )
        floating_button_size = str(settings.get("floating_button_size", "default"))
        if floating_button_size not in FLOATING_BUTTON_SIZES:
            floating_button_size = "default"
        if "layout_padding" in settings:
            layout_padding = self._validated_layout_padding(
                settings.get("layout_padding")
            )
        else:
            layout_padding = self._validated_layout_padding(
                self._read_script_setting(
                    "Script-windowlayouts",
                    LAYOUT_PADDING_KEY,
                    "0",
                )
            )
        group_order = self._validated_group_order(settings.get("group_order", []))
        group_order_json = json.dumps(group_order, separators=(",", ":"))
        for key, enabled in (
            (FLOATING_BUTTON_KEY, floating_enabled),
            (DRAG_TARGETS_KEY, drag_targets_enabled),
        ):
            self._command_output([
                "kwriteconfig6",
                "--file",
                "kwinrc",
                "--group",
                "Plugins",
                "--key",
                key,
                "--type",
                "bool",
                "true" if enabled else "false",
            ])

        self._command_output([
            "kwriteconfig6",
            "--file",
            "kwinrc",
            "--group",
            DRAG_TARGETS_GROUP,
            "--key",
            SHOW_ALL_TARGETS_KEY,
            "--type",
            "bool",
            "true" if show_all_drag_targets else "false",
        ])
        self._command_output([
            "kwriteconfig6",
            "--file",
            "kwinrc",
            "--group",
            DRAG_TARGETS_GROUP,
            "--key",
            TARGET_PLACEMENT_KEY,
            target_placement,
        ])
        self._command_output([
            "kwriteconfig6",
            "--file",
            "kwinrc",
            "--group",
            DRAG_TARGETS_GROUP,
            "--key",
            SHOW_ALL_TOP_TARGETS_KEY,
            "--type",
            "bool",
            "true" if show_all_top_drag_targets else "false",
        ])
        self._command_output([
            "kwriteconfig6",
            "--file",
            "kwinrc",
            "--group",
            FLOATING_BUTTON_GROUP,
            "--key",
            FLOATING_BUTTON_SIZE_KEY,
            floating_button_size,
        ])
        for group in ("Script-windowlayouts", DRAG_TARGETS_GROUP):
            self._command_output([
                "kwriteconfig6",
                "--file",
                "kwinrc",
                "--group",
                group,
                "--key",
                LAYOUT_PADDING_KEY,
                "--type",
                "int",
                str(layout_padding),
            ])
        for group in (
            "Script-windowlayouts",
            FLOATING_BUTTON_GROUP,
            DRAG_TARGETS_GROUP,
        ):
            self._command_output([
                "kwriteconfig6",
                "--file",
                "kwinrc",
                "--group",
                group,
                "--key",
                GROUP_ORDER_KEY,
                group_order_json,
            ])

        # The panel owns a second copy for normal KCM cfg_* bindings. Write it
        # in the same transaction so opening a different frontend never shows
        # stale feature controls.
        floating_js = "true" if floating_enabled else "false"
        drag_targets_js = "true" if drag_targets_enabled else "false"
        show_all_js = "true" if show_all_drag_targets else "false"
        target_placement_js = json.dumps(target_placement)
        show_all_top_js = "true" if show_all_top_drag_targets else "false"
        floating_size_js = json.dumps(floating_button_size)
        layout_padding_js = str(layout_padding)
        group_order_js = json.dumps(group_order_json)
        script = f"""var updated = false;
for (var panelIndex = 0; panelIndex < panelIds.length && !updated; panelIndex++) {{
    var panel = panelById(panelIds[panelIndex]);
    for (var widgetIndex = 0; widgetIndex < panel.widgetIds.length; widgetIndex++) {{
        var widget = panel.widgetById(panel.widgetIds[widgetIndex]);
        if (widget && widget.type === "org.example.windowlayouts") {{
            widget.currentConfigGroup = ["General"];
            widget.writeConfig("floatingButtonEnabled", {floating_js});
            widget.writeConfig("dragTargetsEnabled", {drag_targets_js});
            widget.writeConfig("showAllDragTargets", {show_all_js});
            widget.writeConfig("dragTargetPlacement", {target_placement_js});
            widget.writeConfig("showAllTopDragTargets", {show_all_top_js});
            widget.writeConfig("floatingButtonSize", {floating_size_js});
            widget.writeConfig("layoutPadding", {layout_padding_js});
            widget.writeConfig("groupOrder", {group_order_js});
            updated = true;
            break;
        }}
    }}
}}
print(updated ? "updated" : "missing");"""
        try:
            self._command_output([
                "qdbus-qt6",
                "org.kde.plasmashell",
                "/PlasmaShell",
                "org.kde.PlasmaShell.evaluateScript",
                script,
            ])
        except (OSError, subprocess.SubprocessError):
            pass

        self._reconfigure_kwin()
        self._set_script_enabled("windowlayoutsfloatingbutton", floating_enabled)
        self._set_script_enabled("windowlayoutsdragtargets", drag_targets_enabled)

    @classmethod
    def _script_main_path(cls, plugin_id):
        try:
            data_directory = Path(cls._command_output([
                "qtpaths6",
                "--writable-path",
                "GenericDataLocation",
            ]))
        except (OSError, subprocess.SubprocessError):
            return None

        runtime_root = data_directory / "window-layouts-kde" / "runtime"
        candidates = sorted(
            runtime_root.glob(f"{plugin_id}-*/contents/ui/main.qml"),
            key=lambda path: path.stat().st_mtime_ns,
            reverse=True,
        )
        candidates.append(
            data_directory / "kwin" / "scripts" / plugin_id / "contents" / "ui" / "main.qml"
        )
        return next((path for path in candidates if path.is_file()), None)

    @classmethod
    def _set_script_enabled(cls, plugin_id, enabled):
        if not enabled:
            try:
                cls._command_output([
                    "qdbus-qt6",
                    "org.kde.KWin",
                    "/Scripting",
                    "org.kde.kwin.Scripting.unloadScript",
                    plugin_id,
                ])
            except (OSError, subprocess.SubprocessError):
                pass
            return

        try:
            loaded = cls._command_output([
                "qdbus-qt6",
                "org.kde.KWin",
                "/Scripting",
                "org.kde.kwin.Scripting.isScriptLoaded",
                plugin_id,
            ]).lower() == "true"
        except (OSError, subprocess.SubprocessError):
            loaded = False
        if loaded:
            return

        main_path = cls._script_main_path(plugin_id)
        if main_path is None:
            return
        try:
            script_number = int(cls._command_output([
                "qdbus-qt6",
                "org.kde.KWin",
                "/Scripting",
                "org.kde.kwin.Scripting.loadDeclarativeScript",
                str(main_path),
                plugin_id,
            ]))
            if script_number >= 0:
                cls._command_output([
                    "qdbus-qt6",
                    "org.kde.KWin",
                    "/Scripting",
                    "org.kde.kwin.Scripting.start",
                ])
        except (OSError, ValueError, subprocess.SubprocessError):
            pass

    @classmethod
    def _reconfigure_kwin(cls):
        try:
            cls._command_output([
                "qdbus-qt6",
                "org.kde.KWin",
                "/KWin",
                "org.kde.KWin.reconfigure",
            ])
        except (OSError, subprocess.SubprocessError):
            pass

    @classmethod
    def _reload_cairo_dock(cls):
        """Refresh a running Window Layouts sub-dock after shared saves."""
        try:
            cls._command_output([
                "qdbus-qt6",
                "org.cairodock.CairoDock",
                "/org/cairodock/CairoDock",
                "org.cairodock.CairoDock.Reload",
                "module=window_layouts",
            ])
        except (OSError, subprocess.SubprocessError):
            pass


class ShortcutStorage:
    """Manage Window Layouts shortcuts through KDE's global-shortcut service."""

    SET_PRESENT_AND_NO_AUTOLOADING = 2 | 4

    def __init__(self):
        bus = dbus.SessionBus()
        proxy = bus.get_object("org.kde.kglobalaccel", "/kglobalaccel")
        self.interface = dbus.Interface(proxy, "org.kde.KGlobalAccel")

    @staticmethod
    def action_friendly_name(action_id):
        for unique_name, friendly_name, _label in FIXED_SHORTCUTS:
            if unique_name == action_id:
                return friendly_name
        if action_id.startswith("WindowLayoutsCustom"):
            suffix = action_id.removeprefix("WindowLayoutsCustom")
            if suffix.isdigit() and 1 <= int(suffix) <= MAX_LAYOUTS:
                return f"Window Layouts: Custom {suffix}"
        return f"Window Layouts: {action_id}"

    @classmethod
    def action_identifier(cls, action_id):
        return dbus.Array([
            "kwin",
            action_id,
            "KWin",
            cls.action_friendly_name(action_id),
        ], signature="s")

    @staticmethod
    def shortcut_from_text(text):
        text = str(text).strip()
        if not text or text.lower() == "none":
            return 0
        parts = [part.strip() for part in text.split("+")]
        if parts[-1] == "" and len(parts) > 1:
            parts[-1] = "+"
            while len(parts) > 2 and parts[-2] == "":
                parts.pop(-2)
        modifiers = 0
        for part in parts[:-1]:
            normalized = part.casefold()
            if normalized in ("ctrl", "control"):
                modifiers |= QT_CONTROL
            elif normalized == "alt":
                modifiers |= QT_ALT
            elif normalized == "shift":
                modifiers |= QT_SHIFT
            elif normalized in ("meta", "super", "win", "windows"):
                modifiers |= QT_META
            else:
                raise ValueError(f"Unsupported shortcut modifier: {part}")
        key_name = parts[-1]
        normalized_key = key_name.casefold().replace(" ", "")
        if normalized_key in QT_NAMED_KEYS:
            key = QT_NAMED_KEYS[normalized_key]
        elif normalized_key.startswith("f") and normalized_key[1:].isdigit():
            function_number = int(normalized_key[1:])
            if not 1 <= function_number <= 35:
                raise ValueError("Function key must be between F1 and F35")
            key = 0x01000030 + function_number - 1
        elif len(key_name) == 1:
            key = ord(key_name.upper())
        else:
            raise ValueError(f"Unsupported shortcut key: {key_name}")
        return modifiers | key

    @staticmethod
    def shortcut_to_text(combined):
        combined = int(combined)
        if not combined:
            return ""
        parts = []
        if combined & QT_CONTROL:
            parts.append("Ctrl")
        if combined & QT_ALT:
            parts.append("Alt")
        if combined & QT_SHIFT:
            parts.append("Shift")
        if combined & QT_META:
            parts.append("Meta")
        key = combined & QT_KEY_MASK
        if 0x01000030 <= key <= 0x01000052:
            parts.append(f"F{key - 0x01000030 + 1}")
        elif key in QT_KEY_NAMES:
            parts.append(QT_KEY_NAMES[key])
        elif 0x20 <= key <= 0x10FFFF:
            parts.append(chr(key).upper())
        else:
            parts.append(f"0x{key:x}")
        return "+".join(parts)

    def shortcut(self, action_id):
        keys = self.interface.shortcut(self.action_identifier(action_id))
        return int(keys[0]) if keys else 0

    def entries(self, layouts):
        entries = [
            {"actionId": action_id, "label": label, "shortcut": self.shortcut(action_id)}
            for action_id, _friendly_name, label in FIXED_SHORTCUTS
        ]
        for index, layout in enumerate(layouts):
            slot = layout.get("shortcutSlot", index + 1)
            action_id = f"WindowLayoutsCustom{slot}"
            entries.append({
                "actionId": action_id,
                "label": layout.get("name") or f"Custom Layout {index + 1}",
                "shortcut": self.shortcut(action_id),
            })
        return entries

    def conflicts(self, action_id, shortcut):
        if not shortcut:
            return []
        conflicts = []
        for info in self.interface.getGlobalShortcutsByKey(dbus.Int32(shortcut)):
            if str(info[2]) == "kwin" and str(info[0]) == action_id:
                continue
            conflicts.append({
                "uniqueName": str(info[0]),
                "friendlyName": str(info[1]),
                "componentUnique": str(info[2]),
                "componentFriendly": str(info[3]),
                "keys": [int(key) for key in info[6]],
            })
        return conflicts

    def set_shortcut(self, action_id, shortcut, force=False):
        shortcut = int(shortcut)
        conflicts = self.conflicts(action_id, shortcut)
        if conflicts and not force:
            return {"changed": False, "conflicts": conflicts}
        if force:
            for conflict in conflicts:
                remaining = [key for key in conflict["keys"] if key != shortcut]
                conflict_id = dbus.Array([
                    conflict["componentUnique"],
                    conflict["uniqueName"],
                    conflict["componentFriendly"],
                    conflict["friendlyName"],
                ], signature="s")
                self.interface.setForeignShortcut(
                    conflict_id,
                    dbus.Array(remaining, signature="i"),
                )
        requested = dbus.Array([shortcut] if shortcut else [], signature="i")
        assigned = self.interface.setShortcut(
            self.action_identifier(action_id),
            requested,
            dbus.UInt32(self.SET_PRESENT_AND_NO_AUTOLOADING),
        )
        assigned_key = int(assigned[0]) if assigned else 0
        return {
            "changed": assigned_key == shortcut,
            "conflicts": [],
            "shortcut": assigned_key,
        }


class ConfiguratorService(dbus.service.Object):
    """Own one editor window and present it for every D-Bus request."""

    def __init__(self, bus_name):
        super().__init__(bus_name, OBJECT_PATH)
        self.storage = LayoutStorage()
        self.shortcuts = ShortcutStorage()
        self.window = WindowLayoutsConfigurator(
            self.storage.load,
            self._save_layouts,
            self.storage.load_feature_settings,
            self.storage.save_feature_settings,
            self.storage.load_custom_groups,
            self.storage.save_custom_groups,
            lambda: self.shortcuts.entries(self.storage.load()),
            self.shortcuts.set_shortcut,
        )

    def _clear_unused_custom_shortcuts(self):
        used_slots = {
            layout.get("shortcutSlot") for layout in self.storage.load()
        }
        for slot in range(1, MAX_LAYOUTS + 1):
            if slot not in used_slots:
                self.shortcuts.set_shortcut(
                    f"WindowLayoutsCustom{slot}", 0, True
                )

    def _save_layouts(self, layouts):
        self.storage.save(layouts)
        self._clear_unused_custom_shortcuts()

    @dbus.service.method(INTERFACE_NAME, in_signature="", out_signature="")
    def Show(self):
        GLib.idle_add(self._show_window)

    @dbus.service.method(INTERFACE_NAME, in_signature="", out_signature="")
    def Quit(self):
        GLib.idle_add(Gtk.main_quit)

    @dbus.service.method(INTERFACE_NAME, in_signature="b", out_signature="")
    def SetFloatingButtonEnabled(self, enabled):
        GLib.idle_add(self._set_floating_button_enabled, bool(enabled))

    @dbus.service.method(INTERFACE_NAME, in_signature="", out_signature="s")
    def GetShortcutsJson(self):
        entries = self.shortcuts.entries(self.storage.load())
        return json.dumps({
            entry["actionId"]: self.shortcuts.shortcut_to_text(entry["shortcut"])
            for entry in entries
        }, separators=(",", ":"))

    @dbus.service.method(INTERFACE_NAME, in_signature="", out_signature="")
    def ClearUnusedCustomShortcuts(self):
        self._clear_unused_custom_shortcuts()

    @dbus.service.method(INTERFACE_NAME, in_signature="ssb", out_signature="s")
    def SetShortcutText(self, action_id, shortcut_text, force):
        try:
            shortcut = self.shortcuts.shortcut_from_text(str(shortcut_text))
            result = self.shortcuts.set_shortcut(
                str(action_id), shortcut, bool(force)
            )
            result["text"] = self.shortcuts.shortcut_to_text(
                result.get("shortcut", shortcut)
            )
        except (ValueError, dbus.DBusException) as error:
            result = {"changed": False, "error": str(error)}
        return json.dumps(result, separators=(",", ":"))

    @dbus.service.method(INTERFACE_NAME, in_signature="bbbss", out_signature="")
    def SetFeatureSettings(
        self,
        floating_enabled,
        drag_targets_enabled,
        show_all_drag_targets,
        floating_button_size,
        group_order,
    ):
        GLib.idle_add(
            self._set_feature_settings,
            bool(floating_enabled),
            bool(drag_targets_enabled),
            bool(show_all_drag_targets),
            str(floating_button_size),
            str(group_order),
        )

    @dbus.service.method(INTERFACE_NAME, in_signature="bbsbbss", out_signature="")
    def SetFeatureSettingsV2(
        self,
        floating_enabled,
        drag_targets_enabled,
        target_placement,
        show_all_zone_targets,
        show_all_top_targets,
        floating_button_size,
        group_order,
    ):
        """Save target placement without breaking pre-1.0 frontends."""
        GLib.idle_add(
            self._set_feature_settings_v2,
            bool(floating_enabled),
            bool(drag_targets_enabled),
            str(target_placement),
            bool(show_all_zone_targets),
            bool(show_all_top_targets),
            str(floating_button_size),
            str(group_order),
        )

    @dbus.service.method(INTERFACE_NAME, in_signature="bbsbbssi", out_signature="")
    def SetFeatureSettingsV3(
        self,
        floating_enabled,
        drag_targets_enabled,
        target_placement,
        show_all_zone_targets,
        show_all_top_targets,
        floating_button_size,
        group_order,
        layout_padding,
    ):
        """Save feature settings including edge-aware layout padding."""
        GLib.idle_add(
            self._set_feature_settings_v3,
            bool(floating_enabled),
            bool(drag_targets_enabled),
            str(target_placement),
            bool(show_all_zone_targets),
            bool(show_all_top_targets),
            str(floating_button_size),
            str(group_order),
            int(layout_padding),
        )

    def _show_window(self):
        self.window.show_configurator()
        return GLib.SOURCE_REMOVE

    def _set_floating_button_enabled(self, enabled):
        settings = self.storage.load_feature_settings()
        settings["floating_button_enabled"] = enabled
        self.storage.save_feature_settings(settings)
        return GLib.SOURCE_REMOVE

    def _set_feature_settings(
        self,
        floating_enabled,
        drag_targets_enabled,
        show_all_drag_targets,
        floating_button_size,
        group_order,
    ):
        self.storage.save_feature_settings({
            "floating_button_enabled": floating_enabled,
            "drag_targets_enabled": drag_targets_enabled,
            "show_all_drag_targets": show_all_drag_targets,
            "floating_button_size": floating_button_size,
            "group_order": group_order,
        })
        return GLib.SOURCE_REMOVE

    def _set_feature_settings_v2(
        self,
        floating_enabled,
        drag_targets_enabled,
        target_placement,
        show_all_zone_targets,
        show_all_top_targets,
        floating_button_size,
        group_order,
    ):
        self.storage.save_feature_settings({
            "floating_button_enabled": floating_enabled,
            "drag_targets_enabled": drag_targets_enabled,
            "drag_target_placement": target_placement,
            "show_all_drag_targets": show_all_zone_targets,
            "show_all_top_drag_targets": show_all_top_targets,
            "floating_button_size": floating_button_size,
            "group_order": group_order,
        })
        return GLib.SOURCE_REMOVE

    def _set_feature_settings_v3(
        self,
        floating_enabled,
        drag_targets_enabled,
        target_placement,
        show_all_zone_targets,
        show_all_top_targets,
        floating_button_size,
        group_order,
        layout_padding,
    ):
        self.storage.save_feature_settings({
            "floating_button_enabled": floating_enabled,
            "drag_targets_enabled": drag_targets_enabled,
            "drag_target_placement": target_placement,
            "show_all_drag_targets": show_all_zone_targets,
            "show_all_top_drag_targets": show_all_top_targets,
            "floating_button_size": floating_button_size,
            "group_order": group_order,
            "layout_padding": layout_padding,
        })
        return GLib.SOURCE_REMOVE


def main():
    DBusGMainLoop(set_as_default=True)
    session_bus = dbus.SessionBus()
    bus_name = dbus.service.BusName(
        SERVICE_NAME,
        bus=session_bus,
        do_not_queue=True,
    )
    service = ConfiguratorService(bus_name)
    Gtk.main()
    del service


if __name__ == "__main__":
    main()
